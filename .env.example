# Copy to .env (gitignored) and fill in only the providers you use.
# Real environment variables always win over .env values.
# Every configured provider receives the full text you check.
SAPLING_API_KEY=
GPTZERO_API_KEY=
PANGRAM_API_KEY=
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=
# COPYLEAKS_SANDBOX=1   # sandbox returns MOCK results; they are excluded from the verdict
WINSTON_AI_API_KEY=
ORIGINALITY_API_KEY=
HIVE_API_KEY=
# ZeroGPT account creation, verification and funding remain human-only. The explicit
# init --acquire-credential flow logs in and writes the issued non-expiring key below.
ZEROGPT_EMAIL=
ZEROGPT_PASSWORD=
ZEROGPT_API_KEY=
# Alternatively, advanced callers may provide a current login JWT directly:
# ZEROGPT_BEARER_TOKEN=
